# =============================================================
# PREDICTIVE HEALTHCARE PROJECT — .gitignore
# =============================================================


# ─────────────────────────────────────────
# 🔐 SECRETS & ENVIRONMENT VARIABLES
# ─────────────────────────────────────────
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# ─────────────────────────────────────────
# 🟢 NODE / JAVASCRIPT (backend & frontend)
# ─────────────────────────────────────────
node_modules/
**/node_modules/

# Build outputs
dist/
build/
dist-ssr/
**/dist/
**/build/

# npm / yarn / pnpm logs and lock files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# Local env overrides (Vite, etc.)
*.local

# ─────────────────────────────────────────
# 🐍 PYTHON / FLASK
# ─────────────────────────────────────────
# Virtual environments
venv/
.venv/
env/
ENV/
**/venv/
**/.venv/

# Python bytecode
__pycache__/
**/__pycache__/
*.py[cod]
*.pyo
*.pyd

# Python packaging artifacts
*.egg
*.egg-info/
dist/
build/
.eggs/
pip-wheel-metadata/

# ─────────────────────────────────────────
# 📓 JUPYTER / ANACONDA
# ─────────────────────────────────────────
.ipynb_checkpoints/
**/.ipynb_checkpoints/
.virtual_documents/
**/.virtual_documents/
.anaconda/
anaconda_projects/db/
**/anaconda_projects/

# ─────────────────────────────────────────
# 🤖 ML MODEL FILES (large binary files)
# ─────────────────────────────────────────
# Trained model binaries — regenerate via notebooks
ml-model/saved_models/*.pkl
ml-model/saved_models/*.h5
ml-model/saved_models/*.joblib
ml-model/saved_models/*.model
ml-model/saved_models/*.pt
ml-model/saved_models/*.pth



# Model visualisation images (auto-generated)
ml-model/saved_models/*.png
ml-model/saved_models/*.jpg

# ─────────────────────────────────────────
# 📊 TRAINING DATASETS (large & private)
# ─────────────────────────────────────────
ml-model/data/*.csv
ml-model/data/*.xlsx
ml-model/data/*.json
ml-model/data/*.parquet
ml-model/data/*.db
ml-model/data/*.sqlite

# ─────────────────────────────────────────
# 🗄️ DATABASE FILES
# ─────────────────────────────────────────
*.sqlite
*.sqlite3
*.db
*.sql

# ─────────────────────────────────────────
# 🖥️ OPERATING SYSTEM FILES
# ─────────────────────────────────────────
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~

# ─────────────────────────────────────────
# ✏️ EDITOR / IDE FILES
# ─────────────────────────────────────────
# VS Code (keep extensions recommendations)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# JetBrains / PyCharm
.idea/
*.iml
*.iws
*.ipr

# Vim / Emacs
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*#

# ─────────────────────────────────────────
# 🔑 KEYS & CERTIFICATES
# ─────────────────────────────────────────
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
*.jks
secrets/
credentials/

# ─────────────────────────────────────────
# 📝 LOGS & TEMPORARY FILES
# ─────────────────────────────────────────
logs/
*.log
tmp/
temp/
.temp/
.tmp/

# ─────────────────────────────────────────
# 📦 MISCELLANEOUS
# ─────────────────────────────────────────
# Coverage reports
coverage/
.coverage
htmlcov/
.pytest_cache/

# MyPy
.mypy_cache/

# Profiling
*.prof